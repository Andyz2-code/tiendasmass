# =============================================================================
# VARIABLES DE ENTORNO - SISTEMA DE GESTIÓN COMERCIAL TIENDAS MASS
# =============================================================================

# Entorno de la aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/tiendasmass/backend/public
APP_TIMEZONE=America/Lima

# Conexión a Base de Datos (MySQL / MariaDB en XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tiendas_mass_db
DB_USERNAME=root
DB_PASSWORD=

# Configuración de Seguridad y JWT
JWT_SECRET=TiendasMass_SuperSecretKey_Huancayo_2026_Key_MustBeLongAndSecure!
JWT_EXPIRE_HOURS=24

# Parámetros Comerciales Peruanos
COMMERCE_CURRENCY=PEN
COMMERCE_IGV_RATE=0.18
DELIVERY_BASE_COST=4.00
DELIVERY_KM_COST=1.50

# Google Maps API (JavaScript API, Places, Distance Matrix)
# Deja la clave vacía o sustituye por tu clave real; el sistema incluye fallback automático
GOOGLE_MAPS_API_KEY=

# Microservicio Node.js (WebSockets / Tracking)
NODE_SOCKET_URL=http://localhost:4000
